version: 2
project:
  name: anamnesis
tools:
  - claude-code
  - codex
  - cursor
fragments:
  - id: base
    version: 23
settings:
  ontology_file: system_graph.yaml
  agents_md_path: AGENTS.md
  claude_md_path: CLAUDE.md
  commit_on_apply: false
  backup_retention: 10
  max_warm_handoff_archives: 5
  max_cold_handoff_age_days: 90
  max_handoff_bytes: 524288
  work_policy:
    reconciliation:
      preset: frequent
    review:
      preset: advisory
    delegation:
      parallelism: auto
  work_prompt_capture:
    preset: bounded
