{
  "name": "@mcprotein/anamnesis",
  "version": "1.20.4",
  "description": "AI coding agent config lifecycle manager — keeps your agents from forgetting your project",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "agents",
    "ai-coding",
    "ontology",
    "scaffold",
    "lifecycle"
  ],
  "homepage": "https://github.com/MCprotein/anamnesis",
  "bugs": "https://github.com/MCprotein/anamnesis/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCprotein/anamnesis.git"
  },
  "license": "MIT",
  "author": "MCProtein",
  "type": "module",
  "exports": {
    ".": {
      "types": "./cli/dist/api.d.ts",
      "import": "./cli/dist/api.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "anamnesis": "cli/dist/index.js"
  },
  "files": [
    "cli/dist",
    "base",
    "fragments",
    "capabilities",
    "docs",
    "rulebook.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p cli/tsconfig.json",
    "postbuild": "chmod +x cli/dist/index.js",
    "dev": "tsc -p cli/tsconfig.json --watch",
    "benchmark:gallery": "tsx cli/src/index.ts benchmark gallery --write",
    "benchmark:gallery:check": "tsx cli/src/index.ts benchmark gallery --validate",
    "benchmark:prompt-gate": "tsx cli/src/index.ts benchmark prompt-gate",
    "benchmark:retrieval": "tsx cli/src/index.ts benchmark retrieval --write",
    "benchmark:upgrade": "tsx cli/src/index.ts benchmark upgrade --write",
    "benchmark:work-continuity": "tsx cli/src/index.ts benchmark work-continuity --write",
    "benchmark:work-agent-ab": "tsx cli/src/index.ts benchmark work-agent-ab --runs 3 --write",
    "benchmark:work-agent-ab:strict": "tsx cli/src/index.ts benchmark work-agent-ab --runs 9 --strict --write",
    "benchmark:work-agent-ab:diagnostic": "tsx cli/src/index.ts benchmark work-agent-ab --runs 3 --scenarios multi-session-handoff,delegation-review",
    "benchmark:work-parallel-agent-ab": "tsx cli/src/index.ts benchmark work-parallel-agent-ab --protocol validate",
    "benchmark:work-parallel-agent-ab:shadow": "tsx cli/src/index.ts benchmark work-parallel-agent-ab --protocol shadow --model gpt-5.6-luna --write",
    "benchmark:work-parallel-agent-ab:final": "tsx cli/src/index.ts benchmark work-parallel-agent-ab --protocol final --model gpt-5.6-luna --write",
    "dogfood": "tsx cli/src/index.ts dogfood check --append",
    "dogfood:check": "tsx cli/src/index.ts dogfood check",
    "doctor:check": "tsx cli/src/index.ts doctor",
    "release:status": "node scripts/release.mjs status",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "release:verify": "node scripts/release.mjs verify",
    "release:check": "tsx cli/src/index.ts release check && npm run lint && npm run dogfood:check && npm run doctor:check && npm run benchmark:gallery:check && tsx cli/src/index.ts benchmark retrieval && npm run benchmark:prompt-gate && npm run build",
    "typecheck": "tsc -p cli/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint cli/src",
    "lint:fix": "biome lint --write cli/src",
    "clean": "rm -rf cli/dist",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^22.20.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
